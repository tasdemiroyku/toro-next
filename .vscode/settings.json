{
  // ── Dosya İzleme (CPU Spike Önleyici) ─────────────
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/out/**": true,
    "**/build/**": true,
    "**/.turbo/**": true,
    "**/.vercel/**": true,
    "**/.cache/**": true,
    "**/.swc/**": true
  },

  // ── Arama Aramayı Hızlandırma ─────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/out": true,
    "**/build": true,
    "**/.turbo": true,
    "**/.vercel": true,
    "**/.cache": true,
    "**/.swc": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/pnpm-lock.yaml": true
  },
  "search.useIgnoreFiles": true,

  // ── Sadece Görüntü Kirliliğini Gizleme ─────────────
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.swc": true
  },

  // ── macOS M1 Optimizasyonu (TS Server İçin) ─────────────
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority"
  },

  // ── Tailwind IntelliSense CPU Koruyucu ─────────────
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.hg/**",
    "**/bower_components/**"
  ],
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascript",
    "typescript": "typescript",
    "typescriptreact": "typescript"
  }
}